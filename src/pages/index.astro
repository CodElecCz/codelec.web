---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const services = [
	{
		number: '01',
		category: 'TESTOVACÍ & DIAGNOSTICKÝ SOFTWARE',
		title: 'Software pro EoL testery & diagnostiku',
		area: 'eol',
		description:
			'Vývoj testovacích sekvencí, diagnostických a měřicích aplikací pro koncové (EoL) testery a výrobní linky, včetně komunikace s ECU (CAN/LIN) a ukládání výsledků.',
		technologies: ['C/C++', 'Qt', 'LabVIEW', 'TestStand', 'CAN', 'LIN'],
	},
	{
		number: '02',
		category: 'SOFTWARE A EMBEDDED',
		title: 'PC aplikace & embedded vývoj',
		area: 'pc-embedded',
		description:
			'Vývoj zakázkových PC aplikací, softwaru pro kamerové inspekce a zpracování obrazu i embedded programování mikrokontrolérů včetně síťové komunikace.',
		technologies: ['C/C++', 'Qt', 'Basler', 'SQL', 'STM32', 'Atmel', 'RTOS', 'LwIP', 'MbedTLS', 'HTTP/HTTPS'],
	},
	{
		number: '03',
		category: 'PLC & AUTOMATIZACE',
		title: 'PLC řízení & automatizace',
		area: 'plc',
		description:
			'Programování PLC, operátorských panelů (HMI) a bezpečnostních funkcí včetně softwarového oživení jednoúčelových strojů a výrobních linek.',
		technologies: ['Siemens TIA Portal', 'Beckhoff TwinCAT', 'Festo', 'Wago', 'CODESYS'],
	},
];
---

<!doctype html>
<html lang="cs">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-slate-950 bg-none text-base leading-relaxed text-slate-200">
		<Header />
		<main class="m-0 w-full max-w-none p-0">
			<section class="relative isolate overflow-hidden border-b border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900">
				<div aria-hidden="true" class="pointer-events-none absolute -right-36 -top-40 size-[30rem] rounded-full border border-cyan-400/10"></div>
				<div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-20 size-[20rem] rounded-full border border-cyan-400/10"></div>
				<div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-16 lg:py-32">
					<div class="relative">
						<p class="mb-5 flex items-center gap-3 font-mono text-xs font-semibold tracking-[0.2em] text-cyan-300 sm:text-sm">
							<span class="h-px w-8 bg-cyan-400"></span>
							PRŮMYSLOVÝ SOFTWARE · EMBEDDED · PLC
						</p>
						<h1 class="mb-6 max-w-3xl text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
							Vývoj průmyslového software, <span class="text-cyan-300">PLC a embedded aplikací.</span>
						</h1>
						<p class="mb-9 max-w-2xl text-lg leading-relaxed text-slate-300 sm:text-xl">
							Programování testovacích a měřicích aplikací (EoL), řídicích systémů PLC, firmware pro mikrokontroléry a softwaru pro kamerové inspekce.
						</p>
						<div class="flex flex-wrap gap-3">
							<a
								class="inline-flex items-center justify-center rounded-md bg-cyan-400 px-5 py-3 text-sm font-bold text-slate-950 no-underline transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
								href={`${base}contact/`}
							>
								Probrat projekt
								<span aria-hidden="true" class="ml-2">→</span>
							</a>
							<a
								class="inline-flex items-center justify-center rounded-md border border-slate-600 px-5 py-3 text-sm font-semibold text-slate-100 no-underline transition hover:border-slate-400 hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
								href={`${base}reference/`}
							>
								Zobrazit reference
							</a>
						</div>
					</div>

					<div class="relative rounded-xl border border-slate-700/80 bg-slate-900/80 p-6 shadow-2xl shadow-black/30 sm:p-8">
						<div class="mb-8 flex items-center justify-between border-b border-slate-700 pb-4">
							<p class="m-0 font-mono text-xs font-semibold tracking-[0.18em] text-slate-400">KLÍČOVÉ OBLASTI</p>
							<span class="flex items-center gap-2 font-mono text-xs text-emerald-300">
								<span class="size-2 rounded-full bg-emerald-400"></span>
								PRŮMYSL
							</span>
						</div>
						<p class="mb-6 text-2xl font-semibold leading-snug text-white">
							Kompletní vývoj od elektroniky po řídicí software.
						</p>
						<div class="space-y-3">
							{services.map((service) => (
								<a href={`${base}reference/?oblast=${service.area}`} class="flex items-center gap-4 border-t border-slate-800 pt-3 text-slate-300 no-underline transition hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400">
									<span class="font-mono text-xs text-cyan-400">{service.number}</span>
									<span class="text-sm">{service.title}</span>
									<span aria-hidden="true" class="ml-auto h-px flex-1 bg-slate-800"></span>
									<span aria-hidden="true" class="size-1.5 rounded-full bg-cyan-400/80"></span>
								</a>
							))}
						</div>
						<p class="mb-0 mt-8 border-l-2 border-cyan-400 pl-4 text-sm text-slate-400">
							Ing. Radomír Turča, Ph.D.
						</p>
					</div>
				</div>
			</section>

			<section aria-labelledby="services-title" class="bg-slate-950">
				<div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
					<div class="mb-10 max-w-3xl sm:mb-14">
						<p class="mb-3 font-mono text-xs font-semibold tracking-[0.2em] text-cyan-300">SLUŽBY</p>
						<h2 id="services-title" class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
							Co pro vás vyvinu
						</h2>
						<p class="m-0 text-base leading-relaxed text-slate-400 sm:text-lg">
							Od zakázkové elektroniky a firmware po řídicí software pro výrobu a testování.
						</p>
					</div>

					<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
						{services.map((service) => (
							<article id={`sluzba-${service.number}`} class="group scroll-mt-24 rounded-xl border border-slate-800 bg-slate-900/60 p-6 transition duration-200 hover:-translate-y-1 hover:border-cyan-400/40 hover:bg-slate-900 sm:p-7">
								<div class="mb-8 flex items-center justify-between">
									<span class="font-mono text-sm font-semibold text-cyan-300">{service.number}</span>
									<span aria-hidden="true" class="h-px w-12 bg-slate-700 transition group-hover:w-16 group-hover:bg-cyan-400/70"></span>
								</div>
								<p class="mb-2 font-mono text-[0.68rem] font-semibold tracking-[0.17em] text-slate-500">
									{service.category}
								</p>
								<h3 class="mb-3 text-xl font-semibold text-white">{service.title}</h3>
								<p class="mb-6 min-h-28 text-sm leading-relaxed text-slate-400">
									{service.description}
								</p>
								<ul class="m-0 flex list-none flex-wrap gap-2 p-0">
									{service.technologies.map((technology) => (
										<li class="rounded border border-slate-700/80 bg-slate-950/70 px-2.5 py-1 font-mono text-[0.68rem] text-slate-300">
											{technology}
										</li>
									))}
								</ul>
								<a href={`${base}reference/?oblast=${service.area}`} class="mt-6 inline-block text-sm font-semibold text-cyan-300 underline decoration-cyan-400/30 underline-offset-4 transition hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400">
									Zobrazit reference v této oblasti <span aria-hidden="true">→</span>
								</a>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="border-y border-slate-800 bg-slate-900/70">
				<div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-12 sm:px-8 md:flex-row md:items-center md:justify-between">
					<div>
						<p class="mb-2 font-mono text-xs font-semibold tracking-[0.18em] text-cyan-300">PLÁNUJETE NOVÝ PROJEKT NEBO ÚPRAVU LINKY?</p>
						<h2 class="m-0 text-2xl font-bold text-white">Pojďme najít správné řešení.</h2>
					</div>
					<a
						class="inline-flex w-fit items-center justify-center rounded-md border border-cyan-400/60 px-5 py-3 text-sm font-semibold text-cyan-200 no-underline transition hover:bg-cyan-400 hover:text-slate-950"
						href={`${base}contact/`}
					>
						Nezávazně poptat
						<span aria-hidden="true" class="ml-2">→</span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
