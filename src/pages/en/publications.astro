---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Publications | ${SITE_TITLE}`}
			description="Technical notes and articles from CodElec. The current article archive is published in Czech."
		/>
	</head>
	<body class="min-h-screen bg-slate-950 text-base leading-relaxed text-slate-200">
		<Header />
		<main class="m-0 w-full max-w-none p-0">
			<section class="relative isolate overflow-hidden border-b border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900">
				<div aria-hidden="true" class="pointer-events-none absolute -right-36 -top-40 size-[30rem] rounded-full border border-cyan-400/10"></div>
				<div class="relative mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20">
					<p class="mb-4 flex items-center gap-3 font-mono text-xs font-semibold tracking-[0.2em] text-cyan-300 sm:text-sm">
						<span class="h-px w-8 bg-cyan-400"></span>
						CODELEC · TECHNICAL NOTES
					</p>
					<h1 class="mb-5 text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">
						Publications
					</h1>
					<p class="m-0 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
						Technical notes and articles from CodElec. The current article archive is in Czech;
						select a publication below to read its original version.
					</p>
				</div>
			</section>

			<section class="bg-slate-950">
				<div class="mx-auto grid max-w-7xl grid-cols-1 gap-4 px-5 py-12 sm:px-8 sm:py-16 md:grid-cols-2">
					{posts.map((post) => (
						<article class="rounded-xl border border-slate-800 bg-slate-900/60 p-6 transition hover:border-cyan-400/40 hover:bg-slate-900">
							<a
								class="text-lg font-semibold text-white no-underline transition hover:text-cyan-300 sm:text-xl"
								href={getRelativeLocaleUrl('cs', `blog/${post.id}`)}
							>
								{post.data.title}
							</a>
							<p class="mb-4 mt-3 text-sm leading-relaxed text-slate-400">{post.data.description}</p>
							<div class="flex items-center justify-between gap-3 border-t border-slate-800 pt-4">
								<p class="m-0 font-mono text-xs text-slate-500">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<span class="font-mono text-[0.68rem] uppercase tracking-wider text-cyan-300">Czech original →</span>
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
