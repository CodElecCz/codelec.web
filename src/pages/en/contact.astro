---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { CONTACT, SITE_TITLE } from '../../consts';

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact | ${SITE_TITLE}`}
			description="Contact Ing. Radomír Turča, Ph.D. about cooperation, a consultation, or a quotation for industrial software, PLC, and embedded systems."
		/>
	</head>
	<body class="min-h-screen bg-slate-950 bg-none text-base leading-relaxed text-slate-200">
		<Header />
		<main class="m-0 w-full max-w-none p-0">
			<section class="relative isolate overflow-hidden border-b border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900">
				<div aria-hidden="true" class="pointer-events-none absolute -right-36 -top-40 size-[30rem] rounded-full border border-cyan-400/10"></div>
				<div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-20 size-[20rem] rounded-full border border-cyan-400/10"></div>
				<div class="relative mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20">
					<p class="mb-4 flex items-center gap-3 font-mono text-xs font-semibold tracking-[0.2em] text-cyan-300 sm:text-sm">
						<span class="h-px w-8 bg-cyan-400"></span>
						CODELEC · DIRECT CONTACT
					</p>
					<h1 class="mb-5 text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">
						Contact
					</h1>
					<p class="m-0 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
						If you are interested in working together, arranging a consultation, or requesting a
						quotation, please get in touch.
					</p>
				</div>
			</section>

			<section class="bg-slate-950">
				<div class="mx-auto grid max-w-7xl gap-6 px-5 py-12 sm:px-8 sm:py-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-8">
					<div class="space-y-6">
						<section aria-labelledby="direct-contact-title" class="rounded-xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8">
							<p class="mb-2 font-mono text-xs font-semibold tracking-[0.18em] text-cyan-300">DIRECT CONTACT</p>
							<h2 id="direct-contact-title" class="mb-6 text-2xl font-bold text-white">
								{CONTACT.name}
							</h2>

							<dl class="m-0 divide-y divide-slate-800">
								<div class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-4">
									<dt class="text-sm text-slate-500">Specialization</dt>
									<dd class="m-0 text-sm font-medium text-slate-200">
										CodElec — Industrial software, PLC &amp; embedded
									</dd>
								</div>
								<div class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-4">
									<dt class="text-sm text-slate-500">E-mail</dt>
									<dd class="m-0 flex flex-wrap items-center gap-3">
										<a
											class="break-all text-sm font-medium text-cyan-300 underline decoration-cyan-400/30 underline-offset-4 transition hover:text-cyan-200"
											href={`mailto:${CONTACT.email}`}
										>
											{CONTACT.email}
										</a>
										<button
											id="copy-email"
											class="rounded border border-slate-700 px-2.5 py-1 font-mono text-xs text-slate-300 transition hover:border-cyan-400/50 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
											type="button"
										>
											Copy
										</button>
									</dd>
								</div>
								<div class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-4">
									<dt class="text-sm text-slate-500">Phone</dt>
									<dd class="m-0">
										<a
											class="text-sm font-medium text-cyan-300 underline decoration-cyan-400/30 underline-offset-4 transition hover:text-cyan-200"
											href={`tel:${CONTACT.phoneLink}`}
										>
											{CONTACT.phone}
										</a>
									</dd>
								</div>
								<div class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-4">
									<dt class="text-sm text-slate-500">Company ID (IČ)</dt>
									<dd class="m-0 text-sm text-slate-200">
										<a
											class="font-medium text-cyan-300 underline decoration-cyan-400/30 underline-offset-4 transition hover:text-cyan-200"
											href={CONTACT.companyRegistry}
											target="_blank"
											rel="noopener noreferrer"
										>{CONTACT.companyId}</a>
										<span class="text-slate-500">(sole trader)</span>
										<div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
											{CONTACT.directoryLinks.map(({ name, url }) => (
												<a
													class="inline-flex items-center gap-1 text-xs text-cyan-300 underline decoration-cyan-400/30 underline-offset-4 transition hover:text-cyan-200"
													href={url}
													target="_blank"
													rel="noopener noreferrer"
												>
													{name}<span class="sr-only"> (opens in a new tab)</span>
													<svg aria-hidden="true" class="size-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
														<path d="M9 3h4v4M13 3 7 9M12 9v4H3V4h4" />
													</svg>
												</a>
											))}
										</div>
									</dd>
								</div>
								<div class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-4">
									<dt class="text-sm text-slate-500">GitHub</dt>
									<dd class="m-0">
										<a
											class="text-sm font-medium text-cyan-300 underline decoration-cyan-400/30 underline-offset-4 transition hover:text-cyan-200"
											href={CONTACT.github}
											target="_blank"
											rel="noopener noreferrer"
										>
											{CONTACT.github}
										</a>
									</dd>
								</div>
								<div class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-4">
									<dt class="text-sm text-slate-500">Web</dt>
									<dd class="m-0">
										<a
											class="break-all text-sm font-medium text-cyan-300 underline decoration-cyan-400/30 underline-offset-4 transition hover:text-cyan-200"
											href={CONTACT.website}
											target="_blank"
											rel="noopener noreferrer"
										>
											{CONTACT.website}
										</a>
									</dd>
								</div>
							</dl>
							<p id="copy-status" class="mb-0 mt-3 min-h-5 text-xs text-slate-400" aria-live="polite"></p>
						</section>

						<div class="rounded-xl border border-cyan-400/20 bg-cyan-400/5 p-5">
							<p class="m-0 text-sm leading-relaxed text-slate-300">
								To help me respond quickly, include a brief description of the task, the target
								equipment, and any relevant deadlines.
							</p>
						</div>
					</div>

					<section aria-labelledby="inquiry-title" class="rounded-xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8">
						<div class="mb-7">
							<p class="mb-2 font-mono text-xs font-semibold tracking-[0.18em] text-cyan-300">PROJECT INQUIRY</p>
							<h2 id="inquiry-title" class="mb-2 text-2xl font-bold text-white">Tell me about your project</h2>
							<p class="m-0 text-sm text-slate-400">
								Submitting opens your email application with a prepared message.
							</p>
						</div>

						<form id="project-inquiry" data-recipient={CONTACT.email} class="space-y-5">
							<!-- For Web3Forms later, place its access_key hidden field here. -->
							<div class="grid gap-5 sm:grid-cols-2">
								<div>
									<label class="mb-2 block text-sm font-medium text-slate-300" for="name">
										Name / Company <span class="text-cyan-300">*</span>
									</label>
									<input
										class="w-full rounded-md border border-slate-700 bg-slate-950 px-3.5 py-3 text-sm text-white outline-none transition placeholder:text-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/15"
										id="name"
										name="name"
										type="text"
										autocomplete="name"
										required
									/>
								</div>
								<div>
									<label class="mb-2 block text-sm font-medium text-slate-300" for="email">
										E-mail <span class="text-cyan-300">*</span>
									</label>
									<input
										class="w-full rounded-md border border-slate-700 bg-slate-950 px-3.5 py-3 text-sm text-white outline-none transition placeholder:text-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/15"
										id="email"
										name="email"
										type="email"
										autocomplete="email"
										required
									/>
								</div>
							</div>

							<div class="grid gap-5 sm:grid-cols-2">
								<div>
									<label class="mb-2 block text-sm font-medium text-slate-300" for="phone">
										Phone <span class="font-normal text-slate-500">(optional)</span>
									</label>
									<input
										class="w-full rounded-md border border-slate-700 bg-slate-950 px-3.5 py-3 text-sm text-white outline-none transition placeholder:text-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/15"
										id="phone"
										name="phone"
										type="tel"
										autocomplete="tel"
									/>
								</div>
								<div>
									<label class="mb-2 block text-sm font-medium text-slate-300" for="project-area">
										Project area <span class="text-cyan-300">*</span>
									</label>
									<select
										class="w-full rounded-md border border-slate-700 bg-slate-950 px-3.5 py-3 text-sm text-white outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/15"
										id="project-area"
										name="project-area"
										required
									>
										<option value="" disabled selected>Select an area</option>
										<option>Software for EoL testers &amp; measurement</option>
										<option>PC applications &amp; machine vision</option>
										<option>Embedded firmware &amp; microcontrollers</option>
										<option>PLC control &amp; automation</option>
										<option>Other</option>
									</select>
								</div>
							</div>

							<div>
								<label class="mb-2 block text-sm font-medium text-slate-300" for="description">
									Project description <span class="text-cyan-300">*</span>
								</label>
								<textarea
									class="min-h-36 w-full resize-y rounded-md border border-slate-700 bg-slate-950 px-3.5 py-3 text-sm text-white outline-none transition placeholder:text-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/15"
									id="description"
									name="description"
									rows="5"
									required
								></textarea>
							</div>

							<button
								class="inline-flex items-center justify-center rounded-md bg-cyan-400 px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
								type="submit"
							>
								Prepare e-mail <span aria-hidden="true" class="ml-2">→</span>
							</button>
							<p id="form-status" class="m-0 text-xs text-slate-400" aria-live="polite"></p>
						</form>
					</section>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const copyButton = document.querySelector<HTMLButtonElement>('#copy-email');
			const copyStatus = document.querySelector<HTMLElement>('#copy-status');
			const inquiryForm = document.querySelector<HTMLFormElement>('#project-inquiry');
			const formStatus = document.querySelector<HTMLElement>('#form-status');
			const contactEmail = inquiryForm?.dataset.recipient;

			if (!contactEmail) throw new Error('Contact email was not found on the page.');

			copyButton?.addEventListener('click', async () => {
				if (!navigator.clipboard) {
					if (copyStatus) copyStatus.textContent = 'Clipboard access is unavailable. Please copy the e-mail address manually.';
					return;
				}

				try {
					await navigator.clipboard.writeText(contactEmail);
					if (copyStatus) copyStatus.textContent = 'E-mail address copied to the clipboard.';
				} catch (error) {
					console.error('Could not copy the contact e-mail address.', error);
					if (copyStatus) copyStatus.textContent = 'Copy failed. Please select and copy the e-mail address manually.';
				}
			});

			inquiryForm?.addEventListener('submit', (event) => {
				event.preventDefault();

				if (!inquiryForm.reportValidity()) return;

				const formData = new FormData(inquiryForm);
				const name = String(formData.get('name') ?? '');
				const senderEmail = String(formData.get('email') ?? '');
				const senderPhone = String(formData.get('phone') ?? '');
				const projectArea = String(formData.get('project-area') ?? '');
				const description = String(formData.get('description') ?? '');
				const subject = `Project inquiry from ${name}`;
				const body = [
					'Project inquiry',
					'',
					`Name / Company: ${name}`,
					`E-mail: ${senderEmail}`,
					`Phone: ${senderPhone || 'not provided'}`,
					`Project area: ${projectArea}`,
					'',
					'Project description:',
					description,
				].join('\n');

				if (formStatus) formStatus.textContent = 'Opening your e-mail application…';
				window.location.href = `mailto:${contactEmail}?${new URLSearchParams({ subject, body }).toString()}`;
			});
		</script>
	</body>
</html>
