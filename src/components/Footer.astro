---
import { CONTACT } from '../consts';

const year = new Date().getFullYear();
const basePath = import.meta.env.BASE_URL.replace(/\/+$/, '');
const currentPath =
	Astro.url.pathname === basePath
		? ''
		: Astro.url.pathname.startsWith(`${basePath}/`)
			? Astro.url.pathname.slice(basePath.length + 1)
			: Astro.url.pathname.replace(/^\/+/, '');
const isEnglish = currentPath === 'en' || currentPath.startsWith('en/');
---

<footer class="border-t border-slate-800 bg-slate-950 text-slate-400">
	<div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-7 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-8">
		<p class="m-0">
			&copy; {year} CodElec · {CONTACT.name} {isEnglish ? 'All rights reserved.' : 'Všechna práva vyhrazena.'}
		</p>
		<a
			class="inline-flex items-center gap-2 text-slate-300 no-underline transition hover:text-cyan-300"
			href={CONTACT.github}
			target="_blank"
			rel="noopener noreferrer"
		>
			<svg viewBox="0 0 16 16" aria-hidden="true" class="size-4 fill-current">
				<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.68-.37-.01-.38.63-.01.63 1.23.58 1.21 1.23.82.08-.57.31-.96.59-1.18-1.96-.22-4.02-.98-4.02-4.35 0-.96.34-1.74.91-2.35-.09-.22-.4-1.11.09-2.31 0 0 .74-.24 2.42.9a8.4 8.4 0 0 1 4.4 0c1.68-1.14 2.42-.9 2.42-.9.49 1.2.18 2.09.09 2.31.57.61.91 1.39.91 2.35 0 3.38-2.06 4.13-4.03 4.35.32.28.61.81.61 1.64v2.43c0 .21.15.46.56.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
			</svg>
			<span>GitHub</span>
		</a>
	</div>
</footer>
